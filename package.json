{
  "name": "get-env-action",
  "version": "1.1.0",
  "description": "Fetch repository or deployment-environment variables and inject them as env vars and/or step outputs — no deployment environment binding required.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inspira-legal/get-env-action.git"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "npm run lint && npm run test && npm run build",
    "release": "semantic-release"
  },
  "keywords": [
    "github",
    "actions",
    "environment",
    "variables",
    "env",
    "deployment-environment"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "overrides": {
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vercel/ncc": "^0.44.1",
    "semantic-release": "^25.0.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
